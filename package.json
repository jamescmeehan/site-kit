    "./lastmod": "./src/lastmod.mjs",
    "./strip-comments": "./src/strip-comments.mjs",
    "./jsonld": "./src/jsonld.mjs",
    "./llms": "./src/llms.mjs",
    "./faq": "./src/faq.mjs",
    "./lodging": "./src/lodging.mjs",
    "./opt-out": "./src/opt-out.mjs",
