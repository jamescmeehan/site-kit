{
  "name": "@jamescmeehan/site-kit",
  "version": "0.2.1",
  "description": "Build infrastructure shared by kinpine.com, donnerlakeinn.com and ninameehan.com",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
